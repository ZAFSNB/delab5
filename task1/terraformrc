# Локальное зеркало провайдеров Terraform.
# Провайдер kreuzwerker/docker заранее уложен в /plugins (см. Dockerfile),
# поэтому terraform init не обращается к registry.terraform.io.
provider_installation {
  filesystem_mirror {
    path    = "/plugins"
    include = ["registry.terraform.io/*/*"]
  }

  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}
